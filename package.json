{
  "name": "russian-loto-game",
  "version": "0.1.0",
  "private": true,
  "description": "Live Russian Loto game server for Cloudflare Workers + Durable Objects.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test tests/js/",
    "test:worker": "vitest run",
    "test:all": "bun run test && bun run test:worker",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20260401.0",
    "@types/bun": "^1.1.0",
    "@types/qrcode-svg": "^1.1.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "qrcode-svg": "^1.1.0"
  }
}
