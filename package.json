{
  "name": "russian-loto-game",
  "version": "0.1.0",
  "private": true,
  "description": "Live Russian Loto game server for Cloudflare Workers + Durable Objects.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env=\"\"",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:full": "./scripts/deploy-full.sh",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test tests/js/",
    "test:worker": "vitest run",
    "test:all": "bun run test && bun run test:worker",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/bun": "^1.4.1",
    "@types/qrcode-svg": "^1.1.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "qrcode-svg": "^1.1.0"
  }
}
